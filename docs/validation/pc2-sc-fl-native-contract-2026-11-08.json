  "contracts": {
    "ordinary": "Banks0..9 indices0..99; signed writes saturate0..255 and reads zero-extend. Bank10 is not a global100 mirror.",
    "wide": "OnlyPC2/FL banks200..209 indices0..96 are signed BE32 views. SC has no wide view; none has a300 BE16 or400 persistent-word view.",
    "special_byte_writes": "90/95/97/98/100 store the low8 bits. Native getters do not guard their raw array addresses; reviewed extents above describe established persisted/scratch ownership. Portable access outside those reviewed spans is rejected.",
    "cached_99_251": {
      "value": "Unsigned prior seen98[scenarioCatalogIndex], unknown scenario0; never the catalog index.",
      "load_modes": "Initial load and modes1/3 sample before body marking; mode2 preserves the old cache.",
      "later_writes": "Updating98 does not update the cache. Body processing writes1 to98 and90 at the current scenario index while retaining the cache."
    },
    "clock_99_21": "GetLocalTime SYSTEMTIME.wHour on each read; independent of the serialized register map.",
    "actor_descriptors": "64 writes staged XY and zoom100.65 selectors16..19 write staged zoom and pivots; ordinary65 moves displayed XY and ignores its third word. Normal actor loading commits staged XYZ. Publish projects independent live XYZ before captureUi can freeze a frame.",
    "geometry": "PC2/FL zoom100 apply native882x756 closeup anchor correction. SC zoom100 uses unchanged XY and native image dimensions. Other zooms use integer pivot compensation and one scaling pass.",
    "scale_cache": "Native pre-scaled image handles store requested zoom in their metadata. The36-case geometry interpretation uses unscaled input handles; FL effective-loaded-width offsets and its float/time-based mover are separate contracts, not proved by those36 cases.",
    "portable_wire": "PCP3 carries exact family bank lengths and opaque legacy tails. Imported PCP1/2 active bytes, zero extension and excess tail bytes are preserved without exposing a fabricated wider native bank."
  },
